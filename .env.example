# ==========================================================================
# VELVET FLAME — Environment Variables (Vercel Serverless Function)
# ==========================================================================
# Copy these keys into your Vercel Project Settings -> Environment Variables.
# NEVER commit actual secret tokens to public git repositories!

# Meta WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_API_VERSION=v18.0

# WhatsApp Message Template (Optional for structured notification)
WHATSAPP_ORDER_TEMPLATE_NAME=velvet_flame_new_order
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Restaurant WhatsApp Destination Number (without '+' or leading zeros)
RESTAURANT_WHATSAPP_NUMBER=923291132481
